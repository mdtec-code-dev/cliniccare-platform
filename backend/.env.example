SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
# Por defecto usa SQLite (no necesitas configurar nada mas).
# Para usar PostgreSQL, descomenta y ajusta las siguientes lineas:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=cliniccare
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432
# SECRET_KEY = generalo desde tu consola con python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"


CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
